{
  "name": "calaminejs",
  "version": "0.1.0",
  "description": "Fast xlsx/xls/xlsb/ods reader \u2014 calamine compiled to WebAssembly. One artifact for Node, Bun, Deno, browsers and edge workers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/node.js",
    "./dist/workerd.js",
    "./dist/inline.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/workerd.js",
      "node": "./dist/node.js",
      "browser": "./dist/streaming.js",
      "import": "./dist/streaming.js"
    },
    "./slim": {
      "types": "./dist/index.d.ts",
      "import": "./dist/slim.js"
    },
    "./inline": {
      "types": "./dist/index.d.ts",
      "import": "./dist/inline.js"
    },
    "./calamine_wasm_bg.wasm": "./dist/calamine_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs --no-wasm",
    "smoke": "node scripts/smoke.mjs",
    "fixtures": "bun run fixtures:small && node bench/make-fixtures.mjs medium large",
    "test": "bun run test:rust && bun run test:node && bun run test:browser",
    "test:rust": "cargo test",
    "test:node": "for f in test/node/*.test.mjs; do echo \"\u2500\u2500 $f\"; node \"$f\" || exit 1; done",
    "test:browser": "playwright test",
    "test:worker": "echo 'not implemented \u2014 see test/worker/README.md'",
    "bench": "node bench/bench.mjs",
    "bench:bun": "bun bench/bench.mjs",
    "fixtures:small": "node bench/make-fixtures.mjs small && node test/support/make-date-fixture.mjs && ./test/support/fetch-fixtures.sh && node test/support/make-crafted-fixtures.mjs",
    "lint": "cargo fmt --check && cargo clippy --all-targets -- -D warnings"
  },
  "keywords": [
    "xlsx",
    "xls",
    "xlsb",
    "ods",
    "excel",
    "spreadsheet",
    "wasm",
    "calamine"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "xlsx": "^0.18.5"
  }
}
