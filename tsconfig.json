{
  // Type checking only — nothing here is compiled.
  //
  // The test suites run as .ts directly: Node 22.18+ strips types with no flag,
  // and Bun does it natively. So there is no build step for tests and no emitted
  // JavaScript to keep in sync. `tsc` exists purely to check.
  //
  // The point of checking them is dist/*.d.ts. Those declarations are written by
  // hand against a wasm binary, so nothing else verifies they are true. Making
  // the tests their first typed consumer turns them from a claim into a checked
  // artifact.
  "compilerOptions": {
    "noEmit": true,

    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Node strips types rather than compiling them, so anything that needs a
    // runtime transform — enums, parameter properties, namespaces — would parse
    // here and then fail to run. This makes that a type error instead.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    // The suites import ./dist/*.js and Node resolves those literally.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  // Scoped to TypeScript. The .mjs helpers in scripts/ and bench/ stay
  // unchecked: they are build glue, not the surface under test, and pulling
  // them in would need allowJs and buy nothing.
  "include": ["test/**/*.ts", "types/**/*.d.ts", "examples/**/*.ts"],
  "exclude": ["node_modules", "dist", "pkg", "target", "test/fixtures"]
}
